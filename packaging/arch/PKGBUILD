pkgname=tuicli
pkgver=0.1.3
pkgrel=1
pkgdesc='Lightweight terminal desktop environment for Linux TTY'
arch=('x86_64')
url='https://github.com/qalmurri/tuicli'
license=('MIT')
depends=('glibc')
makedepends=('cargo')
source=("git+https://github.com/qalmurri/tuicli.git#tag=v${pkgver}")
sha256sums=('SKIP')

prepare() {
	cd "${srcdir}/${pkgname}"
	export CARGO_HOME="${srcdir}/cargo-home"
	cargo fetch --locked
}

build() {
	cd "${srcdir}/${pkgname}"
	export CARGO_HOME="${srcdir}/cargo-home"
	cargo build --release --frozen
}

package() {
	cd "${srcdir}/${pkgname}"
	install -Dm755 "target/release/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
	install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
